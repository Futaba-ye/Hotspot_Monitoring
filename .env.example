# 复制为 .env 并填写密钥。不要把 .env 提交到仓库。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
TWITTERAPI_IO_KEY=
OFFICIAL_RSS_URLS=https://openai.com/news/rss.xml

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
SMTP_STARTTLS=true
SMTP_SSL=false

# 可选：自定义数据库路径。默认 data/hotspots.db。
# DATABASE_PATH=D:/Code_Projects/Hotspot_Monitoring/data/hotspots.db
SCHEDULER_ENABLED=true
